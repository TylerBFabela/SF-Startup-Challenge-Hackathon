# Copy to .env (gitignored). Never commit real keys.

# OpenAI key: used by the Python Screener agent and by Cognee.
OPENAI_API_KEY=<paste your OpenAI key>
# Cognee reads its LLM key from this variable (same key).
LLM_API_KEY=<paste your OpenAI key>

# The Screener's model. gpt-6-luna is the Band SDK's recommended default; gpt-4o-mini kept looping on sends.
SCREENER_MODEL=gpt-6-luna
